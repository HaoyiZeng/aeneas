/-- [lt_stateful_arc::arc_two_node_strong_cycle]:
    Source: 'tests/src/lt-stateful-arc.rs', lines 852:0-868:1
    Visibility: public -/
def arc_two_node_strong_cycle
  (value_a : Std.I32) (value_b : Std.I32) : Result Unit := do
  let cn ← CycleNode.new value_a
  let l ← Lock.new cn
  let node_a ← Arc.new l
  let cn1 ← CycleNode.new value_b
  let l1 ← Lock.new cn1
  let node_b ← Arc.new l1
  let l2 ← Arc.get node_a
  let (guard, _) ← Lock.write l2
  let (cn2, get_mut_back, _) ← WriteGuard.get_mut guard
  let a ← Arc.clone_arc node_b
  let cn3 ← CycleNode.set_next cn2 a
  let guard1 := get_mut_back cn3
  let _ ← WriteGuard.release guard1
  let l3 ← Arc.get node_b
  let (guard2, _) ← Lock.write l3
  let (cn4, get_mut_back1, _) ← WriteGuard.get_mut guard2
  let a1 ← Arc.clone_arc node_a
  let cn5 ← CycleNode.set_next cn4 a1
  let guard3 := get_mut_back1 cn5
  let _ ← WriteGuard.release guard3
  ok ()

