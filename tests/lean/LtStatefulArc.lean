def arc_rwlock_read_then_write_ordering
  (value : Std.I32) : Result Std.I32 := do
  let l ← Lock.new value
  let shared ← Arc.new l
  let lock ← Arc.get shared
  let read_guard ← Lock.read lock
  let seen ← ReadGuard.get read_guard
  ReadGuard.release read_guard
  let (write_guard, _) ← Lock.write lock
  let (_, get_mut_back, _) ← WriteGuard.get_mut write_guard
  let write_guard1 := get_mut_back 42#i32
  let _ ← WriteGuard.release write_guard1
  ok seen

