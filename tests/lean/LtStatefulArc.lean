def weak_stored_in_struct_back_pointer
  (parent_name : Std.I32) : Result Bool := do
  let parent ← Arc.new ({ «name» := parent_name } : Parent)
  let w ← Arc.downgrade parent
  let o ← Weak.upgrade w
  let still_alive := core.option.Option.is_some o
  core.mem.drop ({ parent := w } : Child)
  ok still_alive

